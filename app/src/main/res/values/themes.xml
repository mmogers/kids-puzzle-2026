<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- No action bar theme. -->
    <!-- Light, not DayNight: the app doesn't support a dark theme, so text/background colors
         set only via theme defaults (not explicit android:textColor) must not flip in dark mode. -->
    <style name="Theme.Design.NoActionBarMy" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/aqua</item>
        <item name="colorPrimaryVariant">@color/blue_dark</item>
        <item name="colorOnPrimary">@color/blue_dark</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="colorPrimaryDark">@color/blue_dark</item>
        <item name="colorAccent">@color/purple</item>
    </style>

</resources>