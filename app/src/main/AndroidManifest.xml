<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/puzzle_game_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/puzzle_game_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Design.NoActionBarMy">

        <activity
            android:name=".ui.ScoreActivity"
            android:exported="false" />
        <activity
            android:name=".ui.GridViewActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CreateUsernameActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ComplexityActivity"
            android:exported="false" />
        <activity
            android:name=".ui.StartActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.PuzzleActivity"
            android:exported="false" />
    </application>
</manifest>